@model flight.Models.Booking

@{
    ViewData["Title"] = "Booking Summary";
}

<div class="container">
    <h2>Booking Summary</h2>
    <div class="card mb-4">
        <div class="card-header">
            <h3>Booking Details</h3>
        </div>
        <div class="card-body">
            <p><strong>Booking ID:</strong> @Model.Id</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("C")</p>
            @if (Model.Status == "Pending")
            {
                <a href="@ViewBag.PaymentLink" class="btn btn-primary">Proceed to Payment</a>
            }
        </div>
    </div>
</div>