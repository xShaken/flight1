@model flight.Models.FlightSearchResultViewModel

<style>
    .selected-flight {
        background-color: #d1f7c4 !important;
    }

    .flight-card {
        border-left: 4px solid transparent;
        transition: all 0.3s ease;
    }

    .flight-card:hover {
        border-left-color: #0d6efd;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
</style>

@if (Model.DepartureFlights.Any())
{
    <h4 class="mt-4">Departure Flights</h4>
    <div class="seat-class-container mb-3">
        <label class="me-2">Select Seat Class:</label>
        <select class="form-select form-select-sm seat-class-select" style="width: auto; display: inline-block;">
            <option value="Economy">Economy</option>
            <option value="Business">Business</option>
            <option value="FirstClass">First Class</option>
        </select>
    </div>

    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Flight No.</th>
                <th>Airline</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>Seats & Prices</th>
                <th>Select</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model.DepartureFlights)
            {
                <tr class="departure-flight-row">
                    <td><strong>@flight.FlightNumber</strong></td>
                    <td>@flight.Airline.Name</td>
                    <td>
                        <i class="bi bi-airplane-fill"></i>
                        @flight.DepartureAirport.Name <br />
                        <small class="text-muted">@flight.DepartureDateTime.ToString("f")</small>
                    </td>
                    <td>
                        <i class="bi bi-geo-alt-fill"></i>
                        @flight.ArrivalAirport.Name <br />
                        <small class="text-muted">@flight.EstimatedArrivalDateTime.ToString("f")</small>
                    </td>
                    <td>
                        @if (flight.EconomySeatsAvailable > 0)
                        {
                            <span class="badge bg-primary">
                                Economy: @flight.EconomySeatsAvailable seats - ₱@flight.EconomyClassPrice
                            </span>
                            <br />
                        }
                        @if (flight.BusinessSeatsAvailable > 0)
                        {
                            <span class="badge bg-success">
                                Business: @flight.BusinessSeatsAvailable seats - ₱@flight.BusinessClassPrice
                            </span>
                            <br />
                        }
                        @if (flight.FirstClassSeatsAvailable > 0)
                        {
                            <span class="badge bg-warning text-dark">
                                First Class: @flight.FirstClassSeatsAvailable seats - ₱@flight.FirstClassPrice
                            </span>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-outline-primary btn-sm select-flight" data-flight-id="@flight.Id" data-is-return="false">
                            <i class="bi bi-check-circle"></i> Select
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.IsRoundTrip && Model.ReturnFlights.Any())
    {
        <h4 class="mt-4">Return Flights</h4>
        <table class="table table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Flight No.</th>
                    <th>Airline</th>
                    <th>Departure</th>
                    <th>Arrival</th>
                    <th>Seats & Prices</th>
                    <th>Select</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flight in Model.ReturnFlights)
                {
                    <tr class="return-flight-row">
                        <td><strong>@flight.FlightNumber</strong></td>
                        <td>@flight.Airline.Name</td>
                        <td>
                            <i class="bi bi-airplane-fill"></i>
                            @flight.DepartureAirport.Name <br />
                            <small class="text-muted">@flight.DepartureDateTime.ToString("f")</small>
                        </td>
                        <td>
                            <i class="bi bi-geo-alt-fill"></i>
                            @flight.ArrivalAirport.Name <br />
                            <small class="text-muted">@flight.EstimatedArrivalDateTime.ToString("f")</small>
                        </td>
                        <td>
                            @if (flight.EconomySeatsAvailable > 0)
                            {
                                <span class="badge bg-primary">
                                    Economy: @flight.EconomySeatsAvailable seats - ₱@flight.EconomyClassPrice
                                </span>
                                <br />
                            }
                            @if (flight.BusinessSeatsAvailable > 0)
                            {
                                <span class="badge bg-success">
                                    Business: @flight.BusinessSeatsAvailable seats - ₱@flight.BusinessClassPrice
                                </span>
                                <br />
                            }
                            @if (flight.FirstClassSeatsAvailable > 0)
                            {
                                <span class="badge bg-warning text-dark">
                                    First Class: @flight.FirstClassSeatsAvailable seats - ₱@flight.FirstClassPrice
                                </span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-outline-primary btn-sm select-flight" data-flight-id="@flight.Id" data-is-return="true">
                                <i class="bi bi-check-circle"></i> Select
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <script>
        // Show the continue button container once flights are displayed
        $("#continueButtonContainer").show();
    </script>
}
else
{
    <p class="text-warning text-center mt-3">
        <i class="bi bi-exclamation-triangle-fill"></i> No flights found for the selected criteria.
    </p>
}