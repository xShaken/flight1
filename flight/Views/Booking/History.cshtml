@model IEnumerable<flight.Models.Booking>

@{
    ViewData["Title"] = "Booking History";
}

<div class="container">
    <h2>Booking History</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no past bookings.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var booking in Model)
            {
                <div class="list-group-item mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5>Booking Reference: @booking.Id</h5>
                        <span class="badge bg-primary">@booking.Status</span>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Departure Flight</h6>
                            <p>
                                <strong>From:</strong> @booking.Flight.DepartureAirport.Name<br />
                                <strong>To:</strong> @booking.Flight.ArrivalAirport.Name<br />
                                <strong>Date:</strong> @booking.Flight.DepartureDateTime.ToShortDateString()<br />
                                <strong>Time:</strong> @booking.Flight.DepartureDateTime.ToString("hh:mm tt") - @booking.Flight.EstimatedArrivalDateTime.ToString("hh:mm tt")<br />
                                <strong>Class:</strong> @booking.SeatClass
                            </p>
                        </div>
                        @if (booking.ReturnFlight != null)
                        {
                            <div class="col-md-6">
                                <h6>Return Flight</h6>
                                <p>
                                    <strong>From:</strong> @booking.ReturnFlight.DepartureAirport.Name<br />
                                    <strong>To:</strong> @booking.ReturnFlight.ArrivalAirport.Name<br />
                                    <strong>Date:</strong> @booking.ReturnFlight.DepartureDateTime.ToShortDateString()<br />
                                    <strong>Time:</strong> @booking.ReturnFlight.DepartureDateTime.ToString("hh:mm tt") - @booking.ReturnFlight.EstimatedArrivalDateTime.ToString("hh:mm tt")<br />
                                    <strong>Class:</strong> @booking.SeatClass
                                </p>
                            </div>
                        }
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Passengers</h6>
                            <ul>
                                @foreach (var guest in booking.Guests)
                                {
                                    <li>@guest.FirstName @guest.LastName (@(guest.IsChild ? "Child" : "Adult"))</li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Payment Details</h6>
                            <p>
                                <strong>Total Price:</strong> ₱@booking.TotalPrice.ToString("N2")<br />
                                @if (booking.Payment != null)
                                {
                                    <strong>Payment Status:</strong> @booking.Payment.Status

                                    <br />
                                    <strong>Payment Date:</strong> @booking.Payment.PaymentDate.ToShortDateString()
                                }
                                <strong>Payment Status:</strong> @booking.Payment.Status<br />
                                <strong>Payment Date:</strong> @booking.Payment.PaymentDate.ToShortDateString()
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>