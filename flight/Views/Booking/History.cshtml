@model IEnumerable<flight.Models.Booking>

@{
    ViewData["Title"] = "Booking History";
}

<div class="container">
    <h2 class="mb-4">Booking History</h2>

    <!-- Search Bar -->
    <div class="mb-4">
        <input type="text" id="searchInput" class="form-control" placeholder="Search by Booking ID, Flight Number, or Passenger Name..." aria-label="Search">
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no past bookings.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped table-bordered" id="bookingTable">
                <thead class="thead-dark">
                    <tr>
                        <th>Booking ID</th>
                        <th>Flight Number</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Date</th>
                        <th>Class</th>
                        <th>Passengers</th>
                        <th>Payment Status</th>
                        <th>Total Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td class="align-middle">@booking.Id</td>
                            <td class="align-middle">@booking.Flight.FlightNumber</td>
                            <td class="align-middle">
                                <div class="flight-details">
                                    <strong>From:</strong> @booking.Flight.DepartureAirport.Name<br />
                                    <strong>To:</strong> @booking.Flight.ArrivalAirport.Name<br />
                                    <strong>Time:</strong> @booking.Flight.DepartureDateTime.ToString("hh:mm tt") - @booking.Flight.EstimatedArrivalDateTime.ToString("hh:mm tt")
                                </div>
                            </td>
                            <td class="align-middle">
                                @if (booking.ReturnFlight != null)
                                {
                                    <div class="flight-details">
                                        <strong>From:</strong> @booking.ReturnFlight.DepartureAirport.Name<br />
                                        <strong>To:</strong> @booking.ReturnFlight.ArrivalAirport.Name<br />
                                        <strong>Time:</strong> @booking.ReturnFlight.DepartureDateTime.ToString("hh:mm tt") - @booking.ReturnFlight.EstimatedArrivalDateTime.ToString("hh:mm tt")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">No return flight</span>
                                }
                            </td>
                            <td class="align-middle">@booking.Flight.DepartureDateTime.ToShortDateString()</td>
                            <td class="align-middle class-column">@booking.SeatClass</td>
                            <td class="align-middle">
                                <ul class="list-unstyled mb-0">
                                    @foreach (var guest in booking.Guests)
                                    {
                                        <li>@guest.FirstName @guest.LastName (@(guest.IsChild ? "Child" : "Adult"))</li>
                                    }
                                </ul>
                            </td>
                            <td class="align-middle payment-status">
                                @if (booking.Payment != null)
                                {
                                    <span class="badge bg-success">@booking.Payment.Status</span>
                                    <br />
                                    <small>@booking.Payment.PaymentDate.ToShortDateString()</small>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </td>
                            <td class="align-middle total-price">₱@booking.TotalPrice.ToString("N2")</td>
                            <td class="align-middle">
                                @if (booking.Status == "Confirmed")
                                {
                                    <a href="/Booking/Ticket/@booking.Id" class="btn btn-view-ticket">View Ticket</a>
                                    <a href="/Booking/FlightStatus/@booking.Flight.Id" class="btn btn-view-status">View Flight Status</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Add jQuery for Search Functionality -->
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#bookingTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}